# Root-owned /etc/bailey/runtime.env, readable by bailey. NO credentials here.
HERMES_HOME=/home/bailey/data
HERMES_SOURCE=/home/bailey/.hermes/hermes-agent
# REQUIRED: absolute Python in the dependency environment selected by Hermes PM.
# Read the actual installation facts / launcher; do not use bare system python.
HERMES_PYTHON=/replace/with/installed/hermes/environment/venv/bin/python
HOME=/home/bailey
PATH=/home/bailey/.local/bin:/usr/local/bin:/usr/bin:/bin
TZ=Africa/Lagos
HF_HOME=/home/bailey/data/cache/huggingface
