# Copy to /etc/bailey/backup.env, root:root mode 0600.
# Use an OFF-HOST encrypted restic repository; initialize it before activation.
RESTIC_REPOSITORY=sftp:backup-user@backup-host:/backups/bailey
# SFTP uses root's restricted SSH key and verified known_hosts. Never disable host checking.
# Object storage may be used instead with its least-privilege credentials here.
